<Window x:Class="WpfApp20.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp20"
        Title="PLC 监控中心 · Modbus TCP 上位机"
        Height="760" Width="1280" MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 侧边栏 ============ -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Margin="18,20,18,16">
                        <TextBlock FontSize="24" Foreground="{StaticResource Brush.Accent}"
                                   Text="&#x25C9;" HorizontalAlignment="Left"/>
                        <TextBlock Text="PLC 监控中心" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text}" Margin="0,8,0,2"/>
                        <TextBlock Text="Modbus TCP 上位机" FontSize="11"
                                   Foreground="{StaticResource Brush.SubText}"/>
                    </StackPanel>

                    <!-- 全局启停 -->
                    <Border DockPanel.Dock="Bottom" Margin="14,10,14,16"
                            Background="{StaticResource Brush.Bg2}" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <Button Content="▶  启动全部监控" Style="{StaticResource Btn.Ok}"
                                    Command="{Binding StartAllCommand}" Margin="0,0,0,8"/>
                            <Button Content="■  停止全部监控" Style="{StaticResource Btn.Danger}"
                                    Command="{Binding StopAllCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- 导航 -->
                    <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding CurrentNav}"
                             Background="Transparent" BorderThickness="0" Margin="6,8,6,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                                    Padding="12,11" Margin="2,1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="icon" Text="{Binding Icon}" FontSize="15"
                                                               Foreground="{StaticResource Brush.SubText}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="title" Text="{Binding Title}" FontSize="14"
                                                               Foreground="{StaticResource Brush.Text}"
                                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#2C2C3E"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#2E3A55"/>
                                                    <Setter TargetName="icon" Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                                    <Setter TargetName="title" Property="Foreground" Value="#DCE9FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ============ 内容区 ============ -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="0"/>
        </Grid>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Panel}" Padding="16,8"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Clock}" Foreground="{StaticResource Brush.SubText}"
                           FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource Brush.Ok}" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" FontSize="12" Margin="6,0,18,0" Foreground="{StaticResource Brush.Text}">
                        <Run Text="在线设备 "/><Run Text="{Binding OnlineCount, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Mgr.Devices.Count, Mode=OneWay}"/>
                    </TextBlock>
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Brush.SubText}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveAlarms, Converter={local:NotZeroConverter}}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock VerticalAlignment="Center" FontSize="12" Margin="6,0,18,0"
                               Foreground="{StaticResource Brush.Text}">
                        <Run Text="活动报警 "/><Run Text="{Binding ActiveAlarms, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.SubText}"
                               Text="数据记录位于程序目录 logs/ 下"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
