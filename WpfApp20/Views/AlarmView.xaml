<UserControl x:Class="WpfApp20.Views.AlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WpfApp20">
    <UserControl.Resources>
        <DataTemplate x:Key="LevelCell">
            <Border CornerRadius="4" Padding="8,2" Background="{Binding LevelBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding LevelText}" FontSize="12" Foreground="White"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Toolbar}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="报警中心" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
                <TextBlock Text="阈值报警触发 / 恢复 / 确认管理" Style="{StaticResource Text.Sub}"
                           VerticalAlignment="Center" Margin="14,4,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,0,0">
                    <CheckBox Content="报警声音" VerticalAlignment="Center"
                              IsChecked="{Binding AlarmSoundEnabled, Mode=TwoWay}"/>
                    <Button Content="√ 确认所选" Margin="16,0,0,0" Style="{StaticResource Btn.Ok}"
                            Click="OnAckSelected" Padding="12,5"/>
                    <Button Content="√ 全部确认" Margin="8,0,0,0" Style="{StaticResource Btn.Accent}"
                            Click="OnAckAll" Padding="12,5"/>
                    <Button Content="📂 打开报警日志目录" Margin="8,0,0,0" Click="OnOpenFolder" Padding="12,5"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="16" Background="Transparent">
            <!-- 活动报警 -->
            <TabItem Header="活动报警">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                    <DataGrid x:Name="ActiveGrid" ItemsSource="{Binding Alarms.ActiveAlarms}"
                              BorderThickness="0" RowBackground="#2A2026" AlternatingRowBackground="#241F23">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="严重">
                                        <Setter Property="Background" Value="#3A2426"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RecoveredAt, Converter={local:NotNullToVisibilityConverter}, ConverterParameter=Collapsed}" Value="Visible">
                                        <Setter Property="Opacity" Value="0.55"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="触发时间" Binding="{Binding FullTimeText}" Width="160"/>
                            <DataGridTextColumn Header="设备" Binding="{Binding DeviceName}" Width="160" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="标签" Binding="{Binding TagName}" Width="140"/>
                            <DataGridTemplateColumn Header="级别" CellTemplate="{StaticResource LevelCell}" Width="80"/>
                            <DataGridTextColumn Header="报警内容" Binding="{Binding Message}" Width="*"/>
                            <DataGridTextColumn Header="恢复时间" Width="160">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="RecoveredAt" TargetNullValue="（未恢复）"
                                             StringFormat='yyyy-MM-dd HH:mm:ss'/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="确认时间" Width="160">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="AcknowledgedAt" TargetNullValue="（未确认）"
                                             StringFormat='yyyy-MM-dd HH:mm:ss'/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- 历史 -->
            <TabItem Header="报警历史（本次会话）">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                    <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding Alarms.History}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="触发时间" Binding="{Binding FullTimeText}" Width="160"/>
                            <DataGridTextColumn Header="设备" Binding="{Binding DeviceName}" Width="160"/>
                            <DataGridTextColumn Header="标签" Binding="{Binding TagName}" Width="140"/>
                            <DataGridTemplateColumn Header="级别" CellTemplate="{StaticResource LevelCell}" Width="80"/>
                            <DataGridTextColumn Header="报警内容" Binding="{Binding Message}" Width="*"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
