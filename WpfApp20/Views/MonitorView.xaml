<UserControl x:Class="WpfApp20.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WpfApp20">
    <UserControl.Resources>
        <local:DeviceStateBrushConverter x:Key="StateBrush"/>
        <local:BoolToBrushConverter x:Key="AlarmBrush"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource Toolbar}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="实时监控" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
                <TextBlock Text="轮询周期自动刷新，双击标签可写入" Style="{StaticResource Text.Sub}"
                           VerticalAlignment="Center" Margin="14,4,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,0,0">
                    <TextBlock Text="设备筛选：" VerticalAlignment="Center" Foreground="{StaticResource Brush.SubText}"/>
                    <ComboBox x:Name="CbDeviceFilter" Width="200" MinHeight="32"
                              SelectionChanged="OnFilterChanged"/>
                    <Button Content="↻ 立即读取" Style="{StaticResource Btn.Accent}" Margin="12,0,0,0" Click="OnReadNow" Padding="12,5"/>
                    <Button Content="✎ 写入值" Margin="8,0,0,0" Click="OnWrite" Padding="12,5"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 概览卡片 -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="16,14,16,4">
            <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="在线 / 总设备" Style="{StaticResource Text.Sub}"/>
                    <TextBlock x:Name="TbOnline" Text="0 / 0" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="活动报警" Style="{StaticResource Text.Sub}"/>
                    <TextBlock x:Name="TbAlarms" Text="0" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Danger}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="监控标签数" Style="{StaticResource Text.Sub}"/>
                    <TextBlock x:Name="TbTags" Text="0" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Accent}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="平均轮询耗时" Style="{StaticResource Text.Sub}"/>
                    <TextBlock x:Name="TbLatency" Text="-- ms" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Purple}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 标签值表格 -->
        <DataGrid Grid.Row="2" x:Name="Grid" Margin="16,4,16,16" MouseDoubleClick="OnGridDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="设备" Binding="{Binding DeviceName}" Width="150" FontWeight="SemiBold"/>
                <DataGridTemplateColumn Header="值" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayValue}" FontSize="15" FontWeight="Bold"
                                       Foreground="{Binding IsAlarming, Converter={StaticResource AlarmBrush}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="标签" Binding="{Binding Name}" Width="160"/>
                <DataGridTextColumn Header="地址" Binding="{Binding AddressText}" Width="70"/>
                <DataGridTextColumn Header="区域" Binding="{Binding AreaText}" Width="130"/>
                <DataGridTextColumn Header="类型" Binding="{Binding DataTypeText}" Width="130"/>
                <DataGridTemplateColumn Header="报警" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#3A3A4E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAlarming}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ActiveAlarmText}" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{Binding IsAlarming, Converter={StaticResource AlarmBrush}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="质量" Binding="{Binding QualityText}" Width="70"/>
                <DataGridTextColumn Header="更新时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="90"/>
                <DataGridTextColumn Header="可写" Binding="{Binding Writable}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
