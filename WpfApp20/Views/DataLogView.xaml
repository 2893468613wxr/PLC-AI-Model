<UserControl x:Class="WpfApp20.Views.DataLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WpfApp20">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 中间内容区占满剩余高度：文件列表和预览表格各自获得有界高度，
                 数据超出时由各自内部滚动条滚动预览 -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Toolbar}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="数据记录" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
                <TextBlock Text="轮询数据自动保存为 CSV（按设备/按天分文件）" Style="{StaticResource Text.Sub}"
                           VerticalAlignment="Center" Margin="14,4,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,0,0">
                    <CheckBox Content="启用数据记录" VerticalAlignment="Center"
                              IsChecked="{Binding DataLogEnabled, Mode=TwoWay}"/>
                    <Button Content="↻ 刷新文件列表" Margin="16,0,0,0" Click="OnRefresh" Padding="12,5"/>
                    <Button Content="📂 打开数据目录" Margin="8,0,0,0" Click="OnOpenFolder" Padding="12,5"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Grid.Column="0" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="数据文件" Style="{StaticResource Text.Sub}" Margin="6,0,0,6"/>
                    <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="OnFileSelected"/>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Grid.Column="1" Margin="10,0,0,0" Padding="0">
                <DockPanel>
                    <TextBlock x:Name="TbPreviewTitle" DockPanel.Dock="Top" Style="{StaticResource Text.Sub}"
                               Margin="12,10,12,6" Text="选择左侧文件查看预览（最多显示前 500 行）"/>
                    <DataGrid x:Name="PreviewGrid" BorderThickness="0"
                              AutoGenerateColumns="True" IsReadOnly="True" FontSize="12"
                              CanUserAddRows="False" HeadersVisibility="Column"/>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="TbStatus" Margin="16,0,16,10" Style="{StaticResource Text.Sub}"/>
    </Grid>
</UserControl>
